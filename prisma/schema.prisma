generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Better Auth tables ───

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          String    @default("admin")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions Session[]
  accounts Account[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ─── Application portal ───

model Application {
  id                    String            @id @default(cuid())
  name                  String
  email                 String
  phone                 String
  cvFilename            String
  cvPath                String
  motivationFilename    String?
  motivationPath        String?
  position              String?
  status                ApplicationStatus @default(NEW)
  notes                 String?           @db.Text
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
}

enum ApplicationStatus {
  NEW
  REVIEWING
  ACCEPTED
  REJECTED
}

// ─── Job postings ───

model Job {
  id                String    @id @default(cuid())
  slug              String    @unique
  active            Boolean   @default(true)
  isApprenticeship  Boolean   @default(false)
  sortOrder         Int       @default(0)

  titleDe           String
  titleEn           String?

  durationDe        String?
  durationEn        String?

  tasksDe           Json      @default("[]")
  tasksEn           Json      @default("[]")

  requirementsDe    Json      @default("[]")
  requirementsEn    Json      @default("[]")

  benefitsDe        Json      @default("[]")
  benefitsEn        Json      @default("[]")

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}
