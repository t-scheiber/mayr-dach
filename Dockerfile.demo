FROM oven/bun:1 AS bun
FROM node:24-bookworm-slim AS build
COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile
COPY . .
RUN bunx prisma generate && bun run build:demo

FROM nginxinc/nginx-unprivileged:stable-alpine
COPY deploy/demo-nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/.demo-out /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s CMD wget -q -O /dev/null http://127.0.0.1:8080/de/ || exit 1
